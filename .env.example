# Copy to a local env file that is not committed. Values stay on your server.
# This plugin does not have its own payment account.

DEMO=1
MERCHANT_ID=demo-store
# stripe, paystack, flutterwave, shopify, or http for any other provider you already use.
PAYMENT_PLUGIN=mock
COMMERCE_PLUGIN=mock
APPROVAL_PLUGIN=threshold
AUTO_APPROVE_BELOW=50.00
SUPPORT_ALERT_ABOVE=50.00
# Your support inbox. Refunds above SUPPORT_ALERT_ABOVE are posted here and wait.
SUPPORT_ALERT_URL=
RETURN_WINDOW_DAYS=30
RATE_LIMIT_RPM=60

# These two tokens must be different. The public token is safe to put in the
# website. The server token stays on your backend and signs shopper sessions.
PLUGIN_PUBLIC_TOKEN=replace-with-a-long-random-public-token
PLUGIN_SERVER_TOKEN=replace-with-a-different-long-random-server-token

# Key values stay in this file on the server only. Do not commit a filled-in copy.
# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Flutterwave
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
# Shopify Admin API token
SHOPIFY_ADMIN_TOKEN=
# Any other payment provider, when PAYMENT_PLUGIN=http
PAYMENT_API_KEY=
# Your commerce system, when COMMERCE_PLUGIN=http
COMMERCE_API_KEY=
# Optional. Set these only to point at a different variable name.
# PAYMENT_SECRET_ENV=PAYMENT_API_KEY
# COMMERCE_SECRET_ENV=COMMERCE_API_KEY

# Used when PAYMENT_PLUGIN=http or COMMERCE_PLUGIN=http.
PAYMENT_BASE_URL=https://payments.example
COMMERCE_BASE_URL=https://commerce.example

# Used when a plugin is stripe or shopify.
SHOPIFY_SHOP=your-store.myshopify.com
APPROVAL_WEBHOOK_URL=

# Optional open-source trace export. Leave blank to keep metrics in this process only.
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Organization rules, policies, and FAQs. The agent reads every .md and .txt file
# in this folder. Samples are used only while the folder is empty and DEMO=1.
# Add a file here, or upload one with the server token: POST /v1/policies
POLICY_DIR=org_rules
HOST=127.0.0.1
PORT=8000
